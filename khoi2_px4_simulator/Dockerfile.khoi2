# Khối 2 — Ubuntu Linux VM / Container Image (PX4 SITL + MAVLink + FastAPI + SQLite)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PORT=8001

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip3 install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    pydantic

COPY khoi2_px4_simulator /workspace/khoi2_px4_simulator

EXPOSE 8001 14540/udp

CMD ["python3", "-m", "uvicorn", "khoi2_px4_simulator.main:app", "--host", "0.0.0.0", "--port", "8001"]
