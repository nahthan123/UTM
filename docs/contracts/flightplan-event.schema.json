{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utm:flightplan-event:1.0",
  "title": "UTM flight plan handoff event",
  "description": "Internal mock integration contract. Each plan belongs to one UAV; submissionId groups related requests. This is not legal authorization or standards certification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "occurredAt", "coordinateSystem", "flightPlan"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": ["string", "null"], "format": "uuid"},
    "eventType": {"enum": ["flightplan.accepted", "flightplan.cancelled", "flightplan.status.changed"]},
    "occurredAt": {"type": ["string", "null"], "format": "date-time"},
    "currentStatus": {"$ref": "#/$defs/flightStatus"},
    "exportOnly": {"type": "boolean"},
    "deliveryRecorded": {"type": "boolean"},
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizontalReference", "epsg", "horizontalFields", "altitudeReference", "altitudeUnit", "timeReference"],
      "properties": {
        "horizontalReference": {"const": "WGS84"},
        "epsg": {"const": 4326},
        "horizontalFields": {"const": ["latitude", "longitude"]},
        "altitudeReference": {"enum": ["AGL", "AMSL"]},
        "altitudeUnit": {"const": "m"},
        "timeReference": {"const": "UTC"}
      }
    },
    "flightPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flightId", "submissionId", "uavCount", "operatorId", "droneId", "serialNumber", "droneType", "performanceProfile", "departureName", "destinationName", "startTime", "endTime", "status", "reviewedAt", "reviewedBy", "reviewNote", "waypoints"],
      "properties": {
        "flightId": {"type": "string", "format": "uuid"},
        "submissionId": {"type": ["string", "null"], "format": "uuid"},
        "uavCount": {"type": "integer", "minimum": 1, "maximum": 50},
        "operatorId": {"type": "string", "format": "uuid"},
        "droneId": {"type": "string", "format": "uuid"},
        "serialNumber": {"type": "string", "minLength": 1, "maxLength": 100},
        "droneType": {"enum": ["MULTIROTOR", "FIXED_WING", "HYBRID", null]},
        "performanceProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxSpeedMps", "maxFlightTimeMinutes"],
          "properties": {
            "maxSpeedMps": {"type": "number", "exclusiveMinimum": 0},
            "maxFlightTimeMinutes": {"type": "integer", "minimum": 1}
          }
        },
        "departureName": {"type": ["string", "null"], "maxLength": 255},
        "destinationName": {"type": ["string", "null"], "maxLength": 255},
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"},
        "status": {"$ref": "#/$defs/flightStatus"},
        "reviewedAt": {"type": ["string", "null"], "format": "date-time"},
        "reviewedBy": {"type": ["string", "null"], "format": "uuid"},
        "reviewNote": {"type": ["string", "null"], "maxLength": 1000},
        "waypoints": {
          "type": "array", "minItems": 2, "maxItems": 10000,
          "items": {
            "type": "object",
            "required": ["latitude", "longitude", "altitude", "time"],
            "properties": {
              "latitude": {"type": "number", "minimum": -90, "maximum": 90},
              "longitude": {"type": "number", "minimum": -180, "maximum": 180},
              "altitude": {"type": "number", "minimum": 0},
              "time": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "flightStatus": {"enum": ["PENDING", "APPROVED", "ACTIVE", "COMPLETED", "REJECTED", "CANCELLED"]}
  },
  "allOf": [
    {
      "if": {"required": ["exportOnly"], "properties": {"exportOnly": {"const": true}}},
      "then": {"required": ["deliveryRecorded"], "properties": {"deliveryRecorded": {"const": false}}},
      "else": {
        "properties": {
          "eventId": {"type": "string", "format": "uuid"},
          "occurredAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}
